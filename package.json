{
  "name": "city-idle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "도시 발전 방치형 게임 - 코어 프로토타입",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && npm test && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/balance-sim.ts",
    "art:check": "node tools/art-check.mjs",
    "art:build": "python3 tools/art-build/make.py && node tools/art-build/people.mjs",
    "unity:check": "node tools/unity-check.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run build && cap sync android && cap open android",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && npm test",
    "check:all": "npm run check && npm run art:check && npm run unity:check && vite build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@types/node": "^22.20.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@revenuecat/purchases-capacitor": "^13.4.2"
  }
}
